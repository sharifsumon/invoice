# PostgreSQL connection for the app
DATABASE_URL="postgresql://invoicecrm:CHANGE_ME@localhost:5432/invoicecrm"
# Separate database used (and recreated) by the test suite — never point this at real data
TEST_DATABASE_URL="postgresql://invoicecrm:CHANGE_ME@localhost:5432/invoicecrm_test"

# 32+ random characters; signs session cookies
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Private file storage (invoice PDFs, logos). Outside /public on purpose.
STORAGE_DIR="./storage"

# Outbound email (invoice delivery). Leave SMTP_HOST empty to use the dev outbox:
# messages are written to STORAGE_DIR/outbox/*.eml and NOT delivered.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Your Company <billing@yourcompany.example>"

# Secret for the scheduler endpoint POST /api/cron/notifications (16+ chars).
# Due/overdue notifications are also generated automatically while people use the app.
CRON_SECRET=""

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe12345"
# 1 = also create demo clients/projects/POs/invoices
SEED_DEMO="0"
